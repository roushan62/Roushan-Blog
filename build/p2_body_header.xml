<body>

  <b:class cond='data:view.isHomepage' name='is-home'/>
  <b:class cond='data:view.isMultipleItems' name='is-index'/>
  <b:class cond='data:view.isSingleItem' name='is-item'/>
  <b:class cond='data:view.isPost' name='is-post'/>
  <b:class cond='data:view.isPage' name='is-page'/>
  <b:class cond='data:view.isError' name='is-error'/>

  <a class='skip-link' href='#main-content'>Skip to main content</a>
  <div class='progress-bar' id='progress-bar'></div>

  <!-- =====================================================
       HEADER
       ===================================================== -->
  <header class='site-header' id='site-header'>
    <div class='container header-inner'>

      <!-- Logo / Blog title -->
      <b:section class='header-brand-sec' id='header' maxwidgets='1' name='Header (Logo)' showaddelement='no'>
        <b:widget id='Header1' locked='true' title='Roushan Blog (Header)' type='Header' version='2' visible='true'>
          <b:includable id='main'>
            <b:if cond='data:imagePlacement == &quot;REPLACE&quot;'>
              <a class='brand-logo' expr:href='data:blog.homepageUrl' expr:title='data:blog.title'>
                <img expr:alt='data:blog.title.escaped' expr:src='data:image'/>
              </a>
              <b:else/>
              <a class='brand-text' expr:href='data:blog.homepageUrl' expr:title='data:blog.title'>
                <span class='brand-mark'>R</span>
                <span class='brand-name'><data:blog.title/></span>
              </a>
            </b:if>
          </b:includable>
        </b:widget>
      </b:section>

      <!-- Main menu -->
      <nav aria-label='Main menu' class='main-menu'>
        <b:section class='main-menu-sec' id='main-menu' maxwidgets='1' name='Main Menu' showaddelement='no'>
          <b:widget id='LinkList1' locked='true' title='Main Menu' type='LinkList' version='2' visible='true'>
            <b:widget-settings>
              <b:widget-setting name='sorting'>NONE</b:widget-setting>
              <b:widget-setting name='text-0'>Home</b:widget-setting>
              <b:widget-setting name='link-0'>/</b:widget-setting>
              <b:widget-setting name='text-1'>Business</b:widget-setting>
              <b:widget-setting name='link-1'>/search/label/Business</b:widget-setting>
              <b:widget-setting name='text-2'>Technology</b:widget-setting>
              <b:widget-setting name='link-2'>/search/label/Technology</b:widget-setting>
              <b:widget-setting name='text-3'>AI</b:widget-setting>
              <b:widget-setting name='link-3'>/search/label/AI</b:widget-setting>
              <b:widget-setting name='text-4'>About</b:widget-setting>
              <b:widget-setting name='link-4'>/p/about.html</b:widget-setting>
              <b:widget-setting name='text-5'>Contact</b:widget-setting>
              <b:widget-setting name='link-5'>/p/contact.html</b:widget-setting>
            </b:widget-settings>
            <b:includable id='main'>
              <b:include name='content'/>
            </b:includable>
            <b:includable id='content'>
              <ul class='menu-list' id='main-menu-nav'>
                <b:loop values='data:links' var='link'>
                  <li><a expr:href='data:link.target'><data:link.name/></a></li>
                  <b:if cond='data:link.name == &quot;Home&quot;'>
                    <li class='has-mega'>
                      <a aria-haspopup='true' href='#'>Topics
                        <svg class='ic chev' viewBox='0 0 24 24'><polyline points='6 9 12 15 18 9'></polyline></svg>
                      </a>
                      <div class='mega-panel'>
                        <div class='mega-col'>
                          <h4>Business</h4>
                          <a href='/search/label/Business'>All Business</a>
                          <a href='/search/label/Startups'>Startups</a>
                          <a href='/search/label/Marketing'>Marketing</a>
                          <a href='/search/label/Money'>Money &amp; Growth</a>
                        </div>
                        <div class='mega-col'>
                          <h4>Technology</h4>
                          <a href='/search/label/Technology'>All Technology</a>
                          <a href='/search/label/Gadgets'>Gadgets</a>
                          <a href='/search/label/Apps'>Apps &amp; Tools</a>
                          <a href='/search/label/Productivity'>Productivity</a>
                        </div>
                        <div class='mega-col'>
                          <h4>Artificial Intelligence</h4>
                          <a href='/search/label/AI'>All AI</a>
                          <a href='/search/label/AI Tools'>AI Tools</a>
                          <a href='/search/label/Automation'>Automation</a>
                          <a href='/search/label/Guides'>Guides</a>
                        </div>
                      </div>
                    </li>
                  </b:if>
                </b:loop>
              </ul>
            </b:includable>
          </b:widget>
        </b:section>
      </nav>

      <!-- Header actions -->
      <div class='header-actions'>
        <button aria-label='Search' class='icon-btn search-open-btn' id='search-open-btn' type='button'>
          <svg class='ic' viewBox='0 0 24 24'><circle cx='11' cy='11' r='8'></circle><line x1='21' y1='21' x2='16.65' y2='16.65'></line></svg>
        </button>
        <button aria-label='Switch dark mode' class='icon-btn theme-toggle' id='theme-toggle' title='Dark / Light mode' type='button'>
          <svg class='ic moon-ic' viewBox='0 0 24 24'><path d='M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z'></path></svg>
          <svg class='ic sun-ic' viewBox='0 0 24 24'><circle cx='12' cy='12' r='5'></circle><line x1='12' y1='1' x2='12' y2='3'></line><line x1='12' y1='21' x2='12' y2='23'></line><line x1='4.22' y1='4.22' x2='5.64' y2='5.64'></line><line x1='18.36' y1='18.36' x2='19.78' y2='19.78'></line><line x1='1' y1='12' x2='3' y2='12'></line><line x1='21' y1='12' x2='23' y2='12'></line><line x1='4.22' y1='19.78' x2='5.64' y2='18.36'></line><line x1='18.36' y1='5.64' x2='19.78' y2='4.22'></line></svg>
        </button>
        <button aria-label='Open menu' class='icon-btn hamburger-btn' id='drawer-open-btn' type='button'>
          <svg class='ic' viewBox='0 0 24 24'><line x1='3' y1='7' x2='21' y2='7'></line><line x1='3' y1='12' x2='21' y2='12'></line><line x1='3' y1='17' x2='15' y2='17'></line></svg>
        </button>
      </div>
    </div>
  </header>

  <!-- Mobile drawer -->
  <div class='drawer-backdrop' id='drawer-backdrop'></div>
  <nav aria-label='Mobile menu' class='mobile-drawer' id='mobile-drawer'>
    <div class='drawer-head'>
      <span>Menu</span>
      <button aria-label='Close menu' class='icon-btn' id='drawer-close-btn' type='button'>
        <svg class='ic' viewBox='0 0 24 24'><line x1='18' y1='6' x2='6' y2='18'></line><line x1='6' y1='6' x2='18' y2='18'></line></svg>
      </button>
    </div>
    <div class='drawer-links' id='drawer-links'></div>
    <div class='drawer-foot'>© <span class='rp-year'>2026</span> <data:blog.title/></div>
  </nav>

  <!-- =====================================================
       TRENDING TICKER
       ===================================================== -->
  <b:section class='ticker' id='ticker-sec' maxwidgets='1' name='Trending Ticker' showaddelement='no'>
    <b:widget id='HTML6' locked='true' title='Trending Ticker' type='HTML' version='2' visible='true'>
      <b:widget-settings>
        <b:widget-setting name='content'>&lt;div class="ticker" id="ticker"&gt;
  &lt;div class="container ticker-inner"&gt;
    &lt;span class="ticker-badge"&gt;Trending&lt;/span&gt;
    &lt;div class="ticker-mask"&gt;&lt;div class="ticker-track" id="ticker-track"&gt;&lt;/div&gt;&lt;/div&gt;
  &lt;/div&gt;
&lt;/div&gt;</b:widget-setting>
      </b:widget-settings>
      <b:includable id='main'>
        <b:include name='content'/>
      </b:includable>
      <b:includable id='content'>
        <data:content/>
      </b:includable>
    </b:widget>
  </b:section>

  <!-- =====================================================
       HERO (Homepage only)
       ===================================================== -->
  <b:if cond='data:view.isHomepage'>
    <b:section class='hero' id='hero' maxwidgets='1' name='Hero Section (Homepage)' showaddelement='no'>
      <b:widget id='HTML1' locked='true' title='Hero Section' type='HTML' version='2' visible='true'>
        <b:widget-settings>
          <b:widget-setting name='content'>&lt;div class="hero-inner container"&gt;
  &lt;div class="hero-copy"&gt;
    &lt;span class="hero-badge"&gt;Personal Blog of Roushan Gupta&lt;/span&gt;
    &lt;h1&gt;Business, Tech &amp;amp; &lt;span class="hl"&gt;AI&lt;svg viewBox="0 0 120 10" preserveAspectRatio="none"&gt;&lt;path d="M3 7 C 40 1, 80 1, 117 6" fill="none" stroke="#30bd9b" stroke-width="3" stroke-linecap="round"&gt;&lt;/path&gt;&lt;/svg&gt;&lt;/span&gt; ideas that help you grow.&lt;/h1&gt;
    &lt;p&gt;Hi, I am Roushan Gupta. On this blog I share practical insights on business, technology and artificial intelligence — simple explanations, real examples and ideas you can actually use.&lt;/p&gt;
    &lt;div class="hero-cta"&gt;
      &lt;a class="btn btn-primary" href="#latest"&gt;Explore Articles &lt;svg class="ic" viewBox="0 0 24 24"&gt;&lt;line x1="5" y1="12" x2="19" y2="12"&gt;&lt;/line&gt;&lt;polyline points="12 5 19 12 12 19"&gt;&lt;/polyline&gt;&lt;/svg&gt;&lt;/a&gt;
      &lt;a class="btn btn-ghost" href="/p/about.html"&gt;About Me&lt;/a&gt;
    &lt;/div&gt;
  &lt;/div&gt;
  &lt;div class="hero-side" aria-hidden="true"&gt;
    &lt;span class="hero-chip chip-1"&gt;&lt;svg class="ic" viewBox="0 0 24 24"&gt;&lt;rect x="2" y="7" width="20" height="14" rx="2"&gt;&lt;/rect&gt;&lt;path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"&gt;&lt;/path&gt;&lt;/svg&gt; Business&lt;/span&gt;
    &lt;span class="hero-chip chip-2"&gt;&lt;svg class="ic" viewBox="0 0 24 24"&gt;&lt;rect x="4" y="4" width="16" height="16" rx="2"&gt;&lt;/rect&gt;&lt;rect x="9" y="9" width="6" height="6"&gt;&lt;/rect&gt;&lt;line x1="9" y1="1" x2="9" y2="4"&gt;&lt;/line&gt;&lt;line x1="15" y1="1" x2="15" y2="4"&gt;&lt;/line&gt;&lt;line x1="9" y1="20" x2="9" y2="23"&gt;&lt;/line&gt;&lt;line x1="15" y1="20" x2="15" y2="23"&gt;&lt;/line&gt;&lt;line x1="20" y1="9" x2="23" y2="9"&gt;&lt;/line&gt;&lt;line x1="20" y1="14" x2="23" y2="14"&gt;&lt;/line&gt;&lt;line x1="1" y1="9" x2="4" y2="9"&gt;&lt;/line&gt;&lt;line x1="1" y1="14" x2="4" y2="14"&gt;&lt;/line&gt;&lt;/svg&gt; Technology&lt;/span&gt;
    &lt;span class="hero-chip chip-3"&gt;&lt;svg class="ic" viewBox="0 0 24 24"&gt;&lt;polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"&gt;&lt;/polygon&gt;&lt;/svg&gt; Artificial Intelligence&lt;/span&gt;
    &lt;div class="hero-card"&gt;
      &lt;div class="hero-card-top"&gt;
        &lt;span class="hero-ava"&gt;R&lt;/span&gt;
        &lt;div&gt;&lt;b&gt;Roushan Gupta&lt;/b&gt;&lt;small&gt;Business · Tech · AI&lt;/small&gt;&lt;/div&gt;
      &lt;/div&gt;
      &lt;div class="hero-card-line"&gt;&lt;/div&gt;
      &lt;div class="hero-card-line w80"&gt;&lt;/div&gt;
      &lt;div class="hero-card-line w60"&gt;&lt;/div&gt;
      &lt;span class="hero-card-tag"&gt;New article every week&lt;/span&gt;
    &lt;/div&gt;
  &lt;/div&gt;
&lt;/div&gt;</b:widget-setting>
        </b:widget-settings>
        <b:includable id='main'>
          <b:include name='content'/>
        </b:includable>
        <b:includable id='content'>
          <data:content/>
        </b:includable>
      </b:widget>
    </b:section>

    <!-- =====================================================
         TOPICS (Homepage only)
         ===================================================== -->
    <b:section class='topics' id='topics' maxwidgets='1' name='Topics Section (Homepage)' showaddelement='no'>
      <b:widget id='HTML2' locked='true' title='Topics Section' type='HTML' version='2' visible='true'>
        <b:widget-settings>
          <b:widget-setting name='content'>&lt;div class="container topics-inner"&gt;
  &lt;div class="topic-card reveal"&gt;
    &lt;span class="topic-icon t-business"&gt;&lt;svg class="ic" viewBox="0 0 24 24"&gt;&lt;rect x="2" y="7" width="20" height="14" rx="2"&gt;&lt;/rect&gt;&lt;path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"&gt;&lt;/path&gt;&lt;/svg&gt;&lt;/span&gt;
    &lt;h3&gt;Business&lt;/h3&gt;
    &lt;p&gt;Startups, marketing, money and growth strategies — practical business ideas explained simply.&lt;/p&gt;
    &lt;a class="topic-link" href="/search/label/Business"&gt;Explore &lt;svg class="ic" viewBox="0 0 24 24"&gt;&lt;line x1="5" y1="12" x2="19" y2="12"&gt;&lt;/line&gt;&lt;polyline points="12 5 19 12 12 19"&gt;&lt;/polyline&gt;&lt;/svg&gt;&lt;/a&gt;
  &lt;/div&gt;
  &lt;div class="topic-card reveal"&gt;
    &lt;span class="topic-icon t-tech"&gt;&lt;svg class="ic" viewBox="0 0 24 24"&gt;&lt;rect x="4" y="4" width="16" height="16" rx="2"&gt;&lt;/rect&gt;&lt;rect x="9" y="9" width="6" height="6"&gt;&lt;/rect&gt;&lt;line x1="9" y1="1" x2="9" y2="4"&gt;&lt;/line&gt;&lt;line x1="15" y1="1" x2="15" y2="4"&gt;&lt;/line&gt;&lt;line x1="9" y1="20" x2="9" y2="23"&gt;&lt;/line&gt;&lt;line x1="15" y1="20" x2="15" y2="23"&gt;&lt;/line&gt;&lt;line x1="20" y1="9" x2="23" y2="9"&gt;&lt;/line&gt;&lt;line x1="20" y1="14" x2="23" y2="14"&gt;&lt;/line&gt;&lt;line x1="1" y1="9" x2="4" y2="9"&gt;&lt;/line&gt;&lt;line x1="1" y1="14" x2="4" y2="14"&gt;&lt;/line&gt;&lt;/svg&gt;&lt;/span&gt;
    &lt;h3&gt;Technology&lt;/h3&gt;
    &lt;p&gt;Gadgets, apps, tools and tech trends that make your work and life easier and smarter.&lt;/p&gt;
    &lt;a class="topic-link" href="/search/label/Technology"&gt;Explore &lt;svg class="ic" viewBox="0 0 24 24"&gt;&lt;line x1="5" y1="12" x2="19" y2="12"&gt;&lt;/line&gt;&lt;polyline points="12 5 19 12 12 19"&gt;&lt;/polyline&gt;&lt;/svg&gt;&lt;/a&gt;
  &lt;/div&gt;
  &lt;div class="topic-card reveal"&gt;
    &lt;span class="topic-icon t-ai"&gt;&lt;svg class="ic" viewBox="0 0 24 24"&gt;&lt;polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"&gt;&lt;/polygon&gt;&lt;/svg&gt;&lt;/span&gt;
    &lt;h3&gt;AI&lt;/h3&gt;
    &lt;p&gt;Artificial intelligence, AI tools and automation — how to use AI to learn faster and earn more.&lt;/p&gt;
    &lt;a class="topic-link" href="/search/label/AI"&gt;Explore &lt;svg class="ic" viewBox="0 0 24 24"&gt;&lt;line x1="5" y1="12" x2="19" y2="12"&gt;&lt;/line&gt;&lt;polyline points="12 5 19 12 12 19"&gt;&lt;/polyline&gt;&lt;/svg&gt;&lt;/a&gt;
  &lt;/div&gt;
&lt;/div&gt;</b:widget-setting>
        </b:widget-settings>
        <b:includable id='main'>
          <b:include name='content'/>
        </b:includable>
        <b:includable id='content'>
          <data:content/>
        </b:includable>
      </b:widget>
    </b:section>

    <!-- =====================================================
         FEATURED SLIDER (Homepage only)
         ===================================================== -->
    <b:section class='feat-sec' id='featured-slider' maxwidgets='1' name='Featured Slider' showaddelement='no'>
      <b:widget id='HTML7' locked='true' title='Featured Slider' type='HTML' version='2' visible='true'>
        <b:widget-settings>
          <b:widget-setting name='content'>&lt;div class="feat-wrap container"&gt;
  &lt;div class="section-head"&gt;
    &lt;h2 class="section-title"&gt;Featured&lt;/h2&gt;
    &lt;p class="section-sub"&gt;Hand-picked stories on business, technology and AI.&lt;/p&gt;
  &lt;/div&gt;
  &lt;div class="feat-slider" id="feat-slider"&gt;
    &lt;div class="feat-track" id="feat-track"&gt;&lt;/div&gt;
    &lt;button type="button" class="feat-nav feat-prev" id="feat-prev" aria-label="Previous featured"&gt;&lt;svg class="ic" viewBox="0 0 24 24"&gt;&lt;polyline points="15 18 9 12 15 6"&gt;&lt;/polyline&gt;&lt;/svg&gt;&lt;/button&gt;
    &lt;button type="button" class="feat-nav feat-next" id="feat-next" aria-label="Next featured"&gt;&lt;svg class="ic" viewBox="0 0 24 24"&gt;&lt;polyline points="9 18 15 12 9 6"&gt;&lt;/polyline&gt;&lt;/svg&gt;&lt;/button&gt;
    &lt;div class="feat-dots" id="feat-dots"&gt;&lt;/div&gt;
  &lt;/div&gt;
&lt;/div&gt;</b:widget-setting>
        </b:widget-settings>
        <b:includable id='main'>
          <b:include name='content'/>
        </b:includable>
        <b:includable id='content'>
          <data:content/>
        </b:includable>
      </b:widget>
    </b:section>
  </b:if>
